{
  "name": "prosepal-backend",
  "version": "1.0.0",
  "description": "ProsePal: An Intelligent Writing Assistant for Web Novel Authors - Backend API Server",
  "main": "dist/app.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "test": "jest",
    "test:db": "ts-node src/utils/testDB.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxlin0524/Web-application-project.git"
  },
  "keywords": [
    "writing-assistant",
    "web-novel",
    "nlp",
    "creative-writing",
    "collaboration-tools",
    "nodejs",
    "express",
    "typescript",
    "mysql",
    "real-time-collaboration"
  ],
  "author": "Junxi Lin (202218020401)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jxlin0524/Web-application-project/issues"
  },
  "homepage": "https://github.com/jxlin0524/Web-application-project#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^6.1.5",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "mysql2": "^3.15.3",
    "openai": "^6.14.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/controllers/**/*.ts"
    ]
  }
}
